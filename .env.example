# Supabase public project keys (safe to ship to the client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side database connections
# DATABASE_URL: transaction-pooler URL used by the running app (port 6543).
# DATABASE_DIRECT_URL: direct connection used by drizzle-kit migrations and the seed script (port 5432).
DATABASE_URL=
DATABASE_DIRECT_URL=

# Service-role key — ONLY used by scripts/db/seed.ts to create auth users.
# Never expose to the client. Never commit. Never log.
SUPABASE_SERVICE_ROLE_KEY=